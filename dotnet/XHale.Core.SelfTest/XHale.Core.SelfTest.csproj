<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free self-test for sensor profile behavior. Run: dotnet run (project dir dotnet/XHale.Core.SelfTest) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XHale.Core/XHale.Core.csproj" />
  </ItemGroup>
</Project>
